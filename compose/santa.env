# The CTFd instance for the santa_shooter subject (PLAN.md §15).
#
# One instance per workshop session (PLAN.md §10) — this is that model applied
# locally, so the pypong instance on 8080 and the pacman one on 8081 keep
# running untouched.
#
#   docker compose --env-file compose/santa.env -p ctfd-santa up -d
#   docker compose --env-file compose/santa.env -p ctfd-santa down
#
# Reset it (the data dir is root-owned, hence the alpine container):
#
#   docker compose --env-file compose/santa.env -p ctfd-santa down
#   docker run --rm -v "$PWD/.data-santa:/data" alpine sh -c 'rm -rf /data/*'
#
# 8000/8001 are ctfd_replication, 8080 is pypong, 8081 is pacman, and 8082 is
# the disposable one scripts/phase2_validate.py wipes.
WS_PORT=8083
WS_DATA=./.data-santa
