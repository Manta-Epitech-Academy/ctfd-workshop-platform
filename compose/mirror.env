# A generic mirroring cache (PLAN.md §18.8): tries each upstream in order, caches
# what it gets, and falls back to a local copy. Nothing in it is specific to the
# thing being mirrored — the first user is the v86 workshop bundle.
#
#   docker compose --env-file compose/mirror.env --profile mirror up -d
#
# Participants then download from  http://<host>:8090/<file>  and pick the file
# in the runtime's welcome screen (the manual flow, PLAN.md §18.8).
#
# Stage the last-resort local copy, for a venue whose uplink dies:
#
#   docker cp shell-rpg-256M.v86b ctfd_coding_platform-mirror-1:/srv/mirror/
#
# The upstreams below are the ones shell-rpg already ships in its own .env:
# a Cloudflare R2 CDN first, then the GitHub release, then GitLab, then the
# Epitech lab host. Unused slots may be left at the discard-port default.
MIRROR_PORT=8090
MIRROR_UPSTREAM_1=https://cdn.cazal.eu
MIRROR_UPSTREAM_2=https://github.com/kevin-cazal/shell-rpg-vm-image/releases/latest/download
MIRROR_UPSTREAM_3=https://gitlab.com/api/v4/projects/83317928/packages/generic/vm-artifacts/latest
MIRROR_UPSTREAM_4=https://lab.epitech.academy/dl
MIRROR_CACHE_SIZE=8g
MIRROR_MAX_AGE=604800
MIRROR_RESOLVER=127.0.0.11 1.1.1.1
