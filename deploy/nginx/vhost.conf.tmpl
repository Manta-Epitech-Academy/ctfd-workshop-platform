#
# Certbot never edits these: certificates are obtained with
# `certbot certonly --webroot`, so nothing rewrites a generated file behind
# our back. The port-80 block below keeps the ACME path reachable for renewals.

server {
    listen 80;
    listen [::]:80;
    server_name @@HOST@@;

    # Matched before the redirect, so HTTP-01 renewal keeps working.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
