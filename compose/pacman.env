# A second CTFd instance, for the pacman subject (PLAN.md §14 phase D).
#
# One instance per workshop session (PLAN.md §10) — this is that model applied
# locally so the pypong instance on 8080 keeps running untouched.
#
#   docker compose --env-file compose/pacman.env -p ctfd-pacman up -d
#   docker compose --env-file compose/pacman.env -p ctfd-pacman down
#
# Reset it (the data dir is root-owned, hence the alpine container):
#
#   docker compose --env-file compose/pacman.env -p ctfd-pacman down
#   docker run --rm -v "$PWD/.data-pacman:/data" alpine sh -c 'rm -rf /data/*'
#
# 8000/8001 are ctfd_replication, 8080 is the pypong instance.
WS_PORT=8081
WS_DATA=./.data-pacman
