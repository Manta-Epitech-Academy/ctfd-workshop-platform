# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
build/
.vite/
*.local

# Env & secrets
.env
.env.*
!.env.example

# CTFd runtime data (never commit). One dir per instance — see compose/*.env.
.data/
.data-*/
*.db
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Instructor validation codes (generated by tools/sync_subject.py)
instructor_codes.*.yaml

# Built runtime dists (tools/build_runtime.sh rebuilds them from a pinned ref)
plugins/workshop/runtimes/

# Claude Code scratch (worktrees, local settings)
# — but not the agent definitions, which are project documentation: who may
# touch what, and how to check it. (`.claude/*`, not `.claude/`: git cannot
# re-include a file whose parent directory is excluded.)
.claude/*
!.claude/agents/

# Production deploy: generated per-instance files (tools/provision.py).
# The manifest and the templates are committed; what they render is not —
# deploy/secrets.yaml is the only copy of the admin passwords.
deploy/secrets.yaml
deploy/nginx/sites/
compose/prod/

# Backups belong in /srv/backups, outside the repo (docs/DEPLOY.md) — a dump
# carries the config table, so the registration code, the token secret and
# every password hash are in it. This is the guard for doing it in-repo anyway.
.backups/
*.sql.gz

# Authored answers. This repo is public: only the .gpg form may be committed.
# tools/answers.sh decrypt|encrypt moves between the two.
content/shell_1/flags.yaml
content/pypong/quiz_answers.yaml

# Local scratch: the resume hint written by Claude Code.
session
