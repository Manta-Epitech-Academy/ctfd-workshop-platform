# The Discover Linux workshop instance — Shell RPG then Shell 1 (PLAN.md §20).
#
#   docker compose --env-file compose/shell.env -p ctfd-shell up -d
#   python3 tools/sync_workshop.py content/workshops/discover-linux \
#       --url http://localhost:8084 --admin-user admin --admin-pass <pw>
#
# Reset it (the data dir is root-owned, hence the alpine container):
#
#   docker compose --env-file compose/shell.env -p ctfd-shell down
#   docker run --rm -v "$PWD/.data-shell:/data" alpine sh -c 'rm -rf /data/*'
#
# 8000/8001 are ctfd_replication, 8080 pypong, 8081 pacman, 8082 the disposable
# validation instance, 8083 santa_shooter.
WS_PORT=8084
WS_DATA=./.data-shell
