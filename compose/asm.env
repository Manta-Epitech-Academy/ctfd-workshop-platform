# The MiniASM workshop instance (PLAN.md §21).
#
#   docker compose --env-file compose/asm.env -p ctfd-asm up -d
#   python3 tools/sync_subject.py content/miniasm --url http://localhost:8085 \
#       --admin-user admin --admin-pass <pw>
#
# Reset it (the data dir is root-owned, hence the alpine container):
#
#   docker compose --env-file compose/asm.env -p ctfd-asm down
#   docker run --rm -v "$PWD/.data-asm:/data" alpine sh -c 'rm -rf /data/*'
#
# 8080 pypong, 8081 pacman, 8082 validation, 8083 santa_shooter, 8084 shell.
WS_PORT=8085
WS_DATA=./.data-asm
